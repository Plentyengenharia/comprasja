{
  "name": "compras-ja",
  "private": true,
  "version": "0.1.0",
  "description": "Compras Já — Plataforma de Licitações Eletrônicas",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@compras-ja/web",
    "dev:api": "turbo run dev --filter=@compras-ja/api",
    "dev:worker": "turbo run dev --filter=@compras-ja/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @compras-ja/database generate",
    "db:migrate": "pnpm --filter @compras-ja/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @compras-ja/database migrate:deploy",
    "db:seed": "pnpm --filter @compras-ja/database seed",
    "db:studio": "pnpm --filter @compras-ja/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "msgpackr-extract"
    ]
  }
}
