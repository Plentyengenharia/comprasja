# Compras Já — variáveis de ambiente (não contém segredos reais)
# Copie para .env e ajuste. Domínios são configuráveis — não há domínio fixo.

NODE_ENV=development
APP_NAME="Compras Já"
APP_SLUG=compras-ja
APP_LOCALE=pt-BR
APP_CURRENCY=BRL
APP_TIMEZONE=America/Sao_Paulo

# Domínios (deixe vazio até o proprietário configurar)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_TRANSPARENCY_URL=http://localhost:3000/transparencia

# Banco
DATABASE_URL=postgresql://comprasja:comprasja@localhost:5432/comprasja?schema=public

# Redis / filas
REDIS_URL=redis://localhost:6379

# Auth (gere valores próprios — NÃO use estes em produção)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Sessão / cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Armazenamento S3-compatível (opcional em development)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=compras-ja
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# E-mail (desativado sem SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Compras Já <noreply@localhost>"

# Integrações — oficiais desativadas por padrão
PNCP_PUBLIC_BASE_URL=https://pncp.gov.br/api
PNCP_PUBLISH_ENABLED=false
PNCP_PUBLISH_BASE_URL=
PNCP_CLIENT_ID=
PNCP_CLIENT_SECRET=

CNPJ_LOOKUP_ENABLED=false
CNPJ_LOOKUP_BASE_URL=

PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=

# Observabilidade
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Feature flags
FEATURE_OFFICIAL_BIDDING=false
FEATURE_MFA=true
FEATURE_DARK_MODE=true
